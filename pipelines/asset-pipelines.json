{
  "schema": "kaminos.pipeline-manifest.v0",
  "version": 0,
  "description": "Kaminos asset generation pipeline manifest. Routes here are runnable composition contracts; stage receipts must say when work is real, fixture-backed, cached, skipped, or failed.",
  "pipelines": [
    {
      "id": "evil-orb-sharp-fixture-pbr-v0",
      "label": "Evil Orb SHARP Fixture: Image To Visible Splat",
      "routeId": "fixture.sharp-splat-pbr-sidecar.v0",
      "description": "Fixture-backed source-image to visible splat candidate to Kaminos import sidecar chain. It copies KAMINOS_SHARP_FIXTURE_SPLAT or a local evil-orb SHARP-derived fixture into the run bundle, records provenance, and can be loaded into the scene. This is not live SHARP, MoGE, or SuperMat inference.",
      "artifacts": {
        "input": {
          "role": "source-image",
          "required": true
        },
        "splat": {
          "role": "splat-candidate",
          "pathTemplate": "artifacts/evil-orb.fixture.ply"
        },
        "sidecar": {
          "role": "kaminos-import-sidecar",
          "pathTemplate": "artifacts/evil-orb.fixture.kaminos-pipeline.json"
        }
      },
      "stages": [
        {
          "id": "fixture-sharp-splat",
          "label": "Copy SHARP Fixture Splat",
          "statusMode": "fixture",
          "route": {
            "id": "fixture.sharp-image-to-splat.v0",
            "tool": "pipeline-witness.mjs",
            "realModel": false,
            "modelFamily": "SHARP",
            "effectiveBackend": "fixture"
          },
          "inputArtifact": "input",
          "outputArtifact": "splat"
        },
        {
          "id": "fixture-kaminos-sidecar",
          "label": "Fixture Kaminos Import Sidecar",
          "statusMode": "fixture",
          "route": {
            "id": "fixture.kaminos-import-sidecar.v0",
            "tool": "pipeline-witness.mjs",
            "realModel": false,
            "effectiveBackend": "fixture"
          },
          "inputArtifact": "splat",
          "outputArtifact": "sidecar"
        }
      ]
    },
    {
      "id": "prepared-splat-import-sidecar-v0",
      "label": "Inspect Existing Splat + Write Import Sidecar",
      "routeId": "prepared.splat-import-sidecar.v0",
      "description": "Inspects an existing splat artifact and writes a Kaminos import sidecar for it. This route does not generate a new splat, does not copy the prepared artifact into a global store, and does not claim renderer truth; use Load Source to view the original selected splat.",
      "artifacts": {
        "input": {
          "role": "prepared-splat",
          "required": true
        },
        "inspection": {
          "role": "prepared-artifact-inspection",
          "pathTemplate": "artifacts/prepared-artifact.inspect.json"
        },
        "sidecar": {
          "role": "kaminos-import-sidecar",
          "pathTemplate": "artifacts/prepared-artifact.kaminos-pipeline.json"
        }
      },
      "stages": [
        {
          "id": "inspect-prepared-splat",
          "label": "Inspect Existing Splat File",
          "statusMode": "prepared-artifact",
          "route": {
            "id": "local.prepared-artifact-inspect.v0",
            "tool": "pipeline-witness.mjs",
            "realModel": false,
            "effectiveBackend": "local-file-inspection"
          },
          "inputArtifact": "input",
          "outputArtifact": "inspection"
        },
        {
          "id": "write-prepared-splat-sidecar",
          "label": "Write Kaminos Import Sidecar",
          "statusMode": "prepared-artifact",
          "route": {
            "id": "local.kaminos-import-sidecar.v0",
            "tool": "pipeline-witness.mjs",
            "realModel": false,
            "effectiveBackend": "local-sidecar-writer"
          },
          "inputArtifact": "inspection",
          "outputArtifact": "sidecar"
        }
      ]
    },
    {
      "id": "sharp-image-to-splat-live-v0",
      "label": "SHARP Image To Visible Splat",
      "routeId": "adapter.sharp-image-to-splat-live.v0",
      "description": "Live source-image to visible splat route. It executes KAMINOS_SHARP_COMMAND with --input, --output, and --report paths. If the adapter is unavailable or fails, the run fails with a durable witness report and does not fall back to the evil-orb fixture.",
      "artifacts": {
        "input": {
          "role": "source-image",
          "required": true
        },
        "splat": {
          "role": "splat-candidate",
          "pathTemplate": "artifacts/sharp-output.ply"
        },
        "sidecar": {
          "role": "kaminos-import-sidecar",
          "pathTemplate": "artifacts/sharp-output.kaminos-pipeline.json"
        }
      },
      "stages": [
        {
          "id": "run-sharp-image-to-splat",
          "label": "Run SHARP Image To Splat Adapter",
          "statusMode": "model-adapter",
          "route": {
            "id": "adapter.sharp-image-to-splat.v0",
            "tool": "SHARP",
            "commandEnv": "KAMINOS_SHARP_COMMAND",
            "modelFamily": "SHARP",
            "realModel": true,
            "executesModel": true,
            "effectiveBackend": "external-command"
          },
          "inputArtifact": "input",
          "outputArtifact": "splat"
        },
        {
          "id": "write-live-sharp-sidecar",
          "label": "Write Live SHARP Import Sidecar",
          "statusMode": "model-adapter",
          "route": {
            "id": "local.kaminos-import-sidecar.v0",
            "tool": "pipeline-witness.mjs",
            "realModel": false,
            "effectiveBackend": "local-sidecar-writer"
          },
          "inputArtifact": "splat",
          "outputArtifact": "sidecar"
        }
      ]
    },
    {
      "id": "live-model-route-adapter-check-v0",
      "label": "Live Model Route Adapter Availability Check",
      "routeId": "adapter.model-chain-availability.v0",
      "description": "Checks whether live model stages have explicit local command configuration. It records availability without executing SHARP, MoGE, SuperMat, Trellis, or other model routes.",
      "artifacts": {
        "input": {
          "role": "source-image",
          "required": true
        },
        "sharpAdapter": {
          "role": "route-adapter-availability-report",
          "pathTemplate": "artifacts/adapter-sharp-image-to-splat.json"
        },
        "mogeAdapter": {
          "role": "route-adapter-availability-report",
          "pathTemplate": "artifacts/adapter-moge-normal-bake.json"
        },
        "supermatAdapter": {
          "role": "route-adapter-availability-report",
          "pathTemplate": "artifacts/adapter-supermat-material-bake.json"
        }
      },
      "stages": [
        {
          "id": "check-sharp-image-to-splat-adapter",
          "label": "Check SHARP Image To Splat Adapter",
          "statusMode": "adapter-check",
          "route": {
            "id": "adapter.sharp-image-to-splat.v0",
            "tool": "SHARP",
            "commandEnv": "KAMINOS_SHARP_COMMAND",
            "modelFamily": "SHARP",
            "executesModel": false
          },
          "inputArtifact": "input",
          "outputArtifact": "sharpAdapter"
        },
        {
          "id": "check-moge-normal-bake-adapter",
          "label": "Check MoGE Normal Bake Adapter",
          "statusMode": "adapter-check",
          "route": {
            "id": "adapter.moge-normal-bake.v0",
            "tool": "MoGE",
            "commandEnv": "KAMINOS_MOGE_COMMAND",
            "modelFamily": "MoGE",
            "executesModel": false
          },
          "inputArtifact": "input",
          "outputArtifact": "mogeAdapter"
        },
        {
          "id": "check-supermat-material-bake-adapter",
          "label": "Check SuperMat Material Bake Adapter",
          "statusMode": "adapter-check",
          "route": {
            "id": "adapter.supermat-material-bake.v0",
            "tool": "SuperMat",
            "commandEnv": "KAMINOS_SUPERMAT_COMMAND",
            "modelFamily": "SuperMat",
            "executesModel": false
          },
          "inputArtifact": "input",
          "outputArtifact": "supermatAdapter"
        }
      ]
    }
  ]
}
